<div class="container">
  <div class="form-card">
    <h1>Đăng ký</h1>
    <form action="#" method="post">
      <div class="form-group has-error">
        <label for="name">Họ tên</label>
        <input type="text" id="name" name="name" autocomplete="name" placeholder="Nguyễn Văn A" aria-invalid="true" aria-describedby="name-error" />
        <p class="form-group__error" id="name-error">
          Họ tên là bắt buộc.
        </p>
      </div>
      <div class="form-group has-error">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" placeholder="you@email.com" aria-invalid="true" aria-describedby="email-error" />
        <p class="form-group__error" id="email-error">
          Email đã tồn tại hoặc không hợp lệ.
        </p>
      </div>
      <div class="form-group has-error">
        <label for="password">Mật khẩu</label>
        <input type="password" id="password" name="password" autocomplete="new-password" placeholder="••••••••" aria-invalid="true" aria-describedby="password-error" />
        <p class="form-group__error" id="password-error">
          Mật khẩu chưa đủ độ mạnh.
        </p>
      </div>
      <div class="form-group has-error">
        <label for="password-confirm">Nhập lại mật khẩu</label>
        <input type="password" id="password-confirm" name="password_confirm" autocomplete="new-password" placeholder="••••••••" aria-invalid="true" aria-describedby="password-confirm-error" />
        <p class="form-group__error" id="password-confirm-error">
          Hai mật khẩu không trùng nhau.
        </p>
      </div>
      <div class="form-actions">
        <button class="btn btn--md btn--primary btn--block" type="submit">
          Tạo tài khoản
        </button>
      </div>
    </form>
    <p class="form-footer">
      Đã có tài khoản? <a href="login.html">Đăng nhập</a>
    </p>
  </div>
</div>