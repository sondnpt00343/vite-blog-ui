<div class="container">
  <div class="page-title">
    <h1>Viết bài</h1>
    <p>
      Soạn bài mới. Khối bên dưới dành cho trình soạn thảo -
      tạm dùng placeholder; sau có thể thay bằng Quill,
      TinyMCE, v.v.
    </p>
  </div>

  <form class="write-form" action="#" method="post">
    <div class="write-card">
      <div class="form-group has-error">
        <label for="post-title">Tiêu đề</label>
        <input type="text" id="post-title" name="title" placeholder="Nhập tiêu đề bài viết" autocomplete="off" aria-invalid="true" aria-describedby="title-error" />
        <p class="form-group__error" id="title-error">
          Tiêu đề là bắt buộc.
        </p>
      </div>
      <div class="form-group has-error">
        <label for="post-excerpt">Tóm tắt (tuỳ chọn)</label>
        <textarea id="post-excerpt" name="excerpt" placeholder="Một đoạn ngắn mô tả bài (sẽ dùng cho thẻ meta hoặc danh sách bài)..." rows="3" aria-invalid="true" aria-describedby="excerpt-error"></textarea>
        <p class="form-group__error" id="excerpt-error">
          Tóm tắt dài quá quy định.
        </p>
      </div>

      <!-- Rich text: mount your editor on #editor-root -->
      <div class="form-group has-error">
        <p class="form-group__label" id="editor-label">
          Nội dung bài
        </p>
        <div id="editor-root" class="editor-placeholder" role="textbox" aria-labelledby="editor-label" aria-describedby="body-error" aria-invalid="true" contenteditable="false">
          <p class="editor-placeholder__hint">
            Chưa gắn trình soạn thảo. Nội dung sẽ hiển
            thị tại đây.
          </p>
        </div>
        <p class="form-group__error" id="body-error">
          Bài cần có nội dung.
        </p>
      </div>

      <div class="form-actions form-actions--split">
        <button class="btn btn--md btn--secondary" type="button">
          Lưu nháp
        </button>
        <button class="btn btn--md btn--primary" type="submit">
          Xuất bản
        </button>
      </div>
    </div>
  </form>
</div>