<div class="container">
  <div class="page-title">
    <h1>UI Elements</h1>
    <p>
      Nút, toast, cảnh báo inline - gom một chỗ cho form và
      trang cài đặt.
    </p>
  </div>

  <p class="elements-hint">
    Modal: bấm nút mở ở dưới, đóng bằng Huỷ, Xác nhận, hoặc bấm
    nền tối.
  </p>

  <section class="elements-section" aria-labelledby="sec-buttons">
    <h2 id="sec-buttons">Button</h2>
    <p class="elements-lead">Kích thước: sm, md, lg</p>

    <div class="element-row">
      <button type="button" class="btn btn--sm btn--normal">
        Small
      </button>
      <button type="button" class="btn btn--md btn--normal">
        Medium
      </button>
      <button type="button" class="btn btn--lg btn--normal">
        Large
      </button>
    </div>

    <div class="element-row">
      <button type="button" class="btn btn--md btn--primary">
        Primary
      </button>
      <button type="button" class="btn btn--md btn--secondary">
        Secondary
      </button>
      <button type="button" class="btn btn--md btn--normal">
        Normal
      </button>
    </div>

    <div class="element-row">
      <button type="button" class="btn btn--md btn--primary btn--rounded">
        Rounded primary
      </button>
      <button type="button" class="btn btn--md btn--secondary btn--rounded">
        Rounded secondary
      </button>
      <button type="button" class="btn btn--md btn--normal btn--rounded">
        Rounded normal
      </button>
    </div>

    <div class="element-row">
      <button type="button" class="btn btn--md btn--bordered">
        Bordered
      </button>
      <button type="button" class="btn btn--md btn--bordered btn--rounded">
        Bordered - rounded
      </button>
    </div>

    <div class="element-row">
      <button type="button" class="btn btn--md btn--primary" disabled>
        Disabled (primary)
      </button>
      <button type="button" class="btn btn--md btn--secondary" disabled>
        Disabled (secondary)
      </button>
      <button type="button" class="btn btn--md btn--normal" disabled>
        Disabled (normal)
      </button>
      <button type="button" class="btn btn--md btn--primary" aria-disabled="true">
        aria-disabled
      </button>
    </div>

    <div class="element-row">
      <button type="button" class="btn btn--sm btn--primary btn--loading" disabled>
        <span class="btn__spinner" aria-hidden="true"></span>
        Đang tải
      </button>
      <button type="button" class="btn btn--md btn--secondary btn--loading" disabled>
        <span class="btn__spinner" aria-hidden="true"></span>
        Đang tải
      </button>
      <button type="button" class="btn btn--lg btn--primary btn--loading" disabled>
        <span class="btn__spinner" aria-hidden="true"></span>
        Đang tải
      </button>
    </div>
  </section>

  <section class="elements-section" aria-labelledby="sec-modal">
    <h2 id="sec-modal">Modal</h2>
    <p class="elements-lead">
      Đóng bằng Huỷ, Xác nhận, hoặc bấm nền tối.
    </p>
    <div class="element-row">
      <a class="btn btn--md btn--primary" href="#modal-confirm">Mở hộp thoại</a>
    </div>
  </section>

  <section class="elements-section" aria-labelledby="sec-message">
    <h2 id="sec-message">Message (inline)</h2>

    <div class="message message--info" role="status">
      <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
      <span>Thông tin: bạn có thể đổi mật khẩu trong mục cài
        đặt tài khoản.</span>
    </div>
    <div class="message message--success" role="status">
      <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
      <span>Thành công: tin nhắn đã gửi.</span>
    </div>
    <div class="message message--error" role="alert">
      <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
      <span>Lỗi: email chưa đúng định dạng.</span>
    </div>
    <div class="message message--warning" role="status">
      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
      <span>Cảnh báo: bạn cần lưu công việc trước khi rời
        trang.</span>
    </div>
  </section>
</div>