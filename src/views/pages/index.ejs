<div class="container">
  <div class="page-title">
    <h1 class="skeleton skeleton-title"></h1>
    <p class="skeleton skeleton-line"></p>
  </div>

  <div class="hero-slider">
    <div class="hero-slider__slide skeleton skeleton-hero" aria-hidden="true"></div>
  </div>

  <div class="post-section">
    <div class="row post-grid gy-4" aria-busy="true">
      <% for (let i = 0; i < 12; i++) { %>
      <div class="col-3 col-xl-6 col-md-6 col-sm-12">
        <article class="post-card post-card--skeleton" aria-hidden="true">
          <div class="post-card__image skeleton"></div>
          <div class="post-card__body">
            <div class="skeleton skeleton-meta"></div>
            <div class="skeleton skeleton-heading"></div>
            <div class="skeleton skeleton-text"></div>
            <div class="skeleton skeleton-text skeleton-text--short"></div>
          </div>
        </article>
      </div>
      <% } %>
    </div>
  </div>

  <section class="topic-section" aria-labelledby="topic-heading">
    <h2 id="topic-heading" class="topic-section__title">
      Xem các bài viết theo chủ đề
    </h2>
    <ul class="topic-tags" aria-busy="true">
      <% for (let i = 0; i < 6; i++) { %>
      <li>
        <span class="topic-tag skeleton skeleton-topic" aria-hidden="true"></span>
      </li>
      <% } %>
    </ul>
  </section>
</div>