<div class="container">
  <div class="form-card">
    <h1>Đăng nhập</h1>
    <form action="#" method="post">
      <div class="form-group has-error">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" placeholder="you@email.com" aria-invalid="true" aria-describedby="email-error" />
        <p class="form-group__error" id="email-error">
          Vui lòng nhập email hợp lệ.
        </p>
      </div>
      <div class="form-group has-error">
        <label for="password">Mật khẩu</label>
        <input type="password" id="password" name="password" autocomplete="current-password" placeholder="••••••••" aria-invalid="true" aria-describedby="password-error" />
        <p class="form-group__error" id="password-error">
          Mật khẩu không đúng hoặc quá ngắn.
        </p>
      </div>
      <div class="form-actions">
        <button class="btn btn--md btn--primary btn--block" type="submit">
          Đăng nhập
        </button>
      </div>
    </form>
    <p class="form-footer">
      Chưa có tài khoản? <a href="register.html">Đăng ký</a>
    </p>
  </div>
</div>