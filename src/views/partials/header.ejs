<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__left">
      <a class="site-header__brand" href="index.html">
        <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
        <span>Blog UI</span>
      </a>
      <nav class="nav-desktop nav-desktop--primary" aria-label="Menu chính">
        <ul class="nav-desktop__list">
          <li>
            <a class="nav-desktop__link" href="index.html" <% if (page.current === "index") { %>aria-current="page" <% } %>><i class="fa-solid fa-house"></i> Trang
              chủ</a>
          </li>
          <li>
            <a class="nav-desktop__link" href="about.html" <% if (page.current === "about") { %>aria-current="page" <% } %>><i class="fa-solid fa-circle-info"></i>
              Giới thiệu</a>
          </li>
          <li>
            <a class="nav-desktop__link" href="contact.html" <% if (page.current === "contact") { %>aria-current="page" <% } %>><i class="fa-solid fa-envelope"></i> Liên
              hệ</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="site-header__end">
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Bật hoặc tắt giao diện tối" aria-pressed="false" title="Giao diện sáng/tối">
        <span class="theme-toggle__icon theme-toggle__icon--when-light" aria-hidden="true"><i class="fa-solid fa-sun"></i></span>
        <span class="theme-toggle__icon theme-toggle__icon--when-dark" aria-hidden="true"><i class="fa-solid fa-moon"></i></span>
      </button>
      <nav class="nav-desktop nav-desktop--secondary" aria-label="Công cụ và tài khoản">
        <ul class="nav-desktop__list">
          <li>
            <a class="nav-desktop__link" href="elements.html" <% if (page.current === "elements") { %>aria-current="page" <% } %>><i class="fa-solid fa-layer-group"></i>
              Elements</a>
          </li>
          <li>
            <a class="nav-desktop__link" href="login.html" <% if (page.current === "login") { %>aria-current="page" <% } %>><i class="fa-solid fa-right-to-bracket"></i>
              Đăng nhập</a>
          </li>
          <li>
            <a class="nav-desktop__link" href="register.html" <% if (page.current === "register") { %>aria-current="page" <% } %>><i class="fa-solid fa-user-plus"></i> Đăng
              ký</a>
          </li>
        </ul>
      </nav>

      <div class="nav-user" role="group" tabindex="0" aria-label="Tài khoản">
        <div class="nav-user__wrap">
          <div class="nav-user__trigger">
            <img class="nav-user__avatar" src="https://picsum.photos/id/1005/72/72" alt="Ảnh đại diện" width="36" height="36" />
            <span class="nav-user__name">Nguyễn Văn A</span>
            <i class="fa-solid fa-chevron-down nav-user__caret" aria-hidden="true"></i>
          </div>
          <div class="nav-user__dropdown">
            <ul class="nav-user__menu">
              <li>
                <a href="write.html">Viết bài</a>
              </li>
              <li>
                <a href="my-posts.html">Bài viết của tôi</a>
              </li>
              <li>
                <a href="#">Đăng xuất</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <button type="button" class="site-header__menu-toggle" title="Mở menu" aria-label="Mở menu" aria-controls="site-sidebar" aria-expanded="false">
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
  </div>
</header>