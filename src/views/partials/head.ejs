<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title data-home-meta-title><%= page.title %></title>
<meta name="description" content="" data-home-meta-desc>
<link rel="stylesheet" href="assets/css/reset.css" />
<link rel="stylesheet" href="assets/css/grid.css" />
<link rel="stylesheet" href="assets/css/style.css" />
<link rel="stylesheet" href="assets/css/theme.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/sondnpt00343/slidezy@main/src/slidezy.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/sondnpt00343/popzy@v1.0.1/popzy.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<script>
  (() => {
    const apply = dark => {
      dark
        ?
        document.documentElement.setAttribute("data-theme", "dark") :
        document.documentElement.removeAttribute("data-theme");

      localStorage.setItem("theme", dark ? "dark" : "light");

      requestIdleCallback(() => {
        document.querySelectorAll("[data-theme-toggle]").forEach(btn => {
          btn.setAttribute("aria-pressed", String(dark));
        });
      })
    }

    apply(localStorage.getItem("theme") === "dark");

    document.addEventListener("click", e => {
      if (!e.target.closest("[data-theme-toggle]")) return;

      const dark = document.documentElement.getAttribute("data-theme") !== "dark";
      apply(dark);
    })
  })();
</script>